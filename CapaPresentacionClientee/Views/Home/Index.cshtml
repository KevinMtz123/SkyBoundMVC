@section scripts{

    <script>

    $(document).ready(function () {
        MostrarEstatus();
        MostrarCategoria();
        MostrarFamilia();
        MostrarHabitat();
        MostrarAve(0, 0, 0, 0)
    })

  function MostrarEstatus() {
    jQuery.ajax({
        url: "@Url.Action("ListarEstatus", "Home")",
        type: "GET",
        dataType: "json",
        contentType: "application/json; charset=utf-8",
        success: function (response) {
            $("#contenedor_estatus").LoadingOverlay("hide");

            $("<div>").addClass("form-check").append(
                $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "estatus", "value": "0", "id": "cx", "checked": "checked" }),
                $("<label>").addClass("form-check-label").text("Todos").attr({ "for": "cx" })
            ).appendTo("#contenedor_estatus");

            $.each(response.data, function (i, element) {
                $("<div>").addClass("form-check").append(
                    $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "estatus", "value": element.IdEstatus, "id": "e" + i }),
                    $("<label>").addClass("form-check-label").text(element.Descripcion).attr({ "for": "e" + i })
                ).appendTo("#contenedor_estatus");
            });
        },
        beforeSend: function () {
            $("#contenedor_estatus").LoadingOverlay("show");
        }
    });
}

