@model CapaEntidad.Ave
@{
    ViewBag.Title = "DetalleAve";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">
            <div class="col-md-6"><img class="card-img-top mb-5 mb-md-0" src="data:image/@Html.DisplayTextFor(a => a.Extension);base64,@Html.DisplayFor(a => a.Base64)" alt="..." /></div>
            <div class="col-md-6">
                <div class="small mb-1">Familia: @Html.DisplayFor(a => a.oFamilia.Descripcion)</div>
                <h1 class="display-5 fw-bolder"> @Html.DisplayFor(a => a.Nombre)</h1>
                <div class="fs-5 mb-5">
                    @*<span class="text-decoration-line-through">$45.00</span>*@
                 
                </div>
                <p class="lead">@Html.DisplayFor(a => a.Descripcion)</p>
                <div class="d-flex">
                    <a href="@Url.Action("Index","Home")" class="btn btn-danger w-50 text-center me-3">
                        <i class="fa-fast-backward fa-undo-alt"></i>Volver
                    </a>

                 


                </div>
            </div>
        </div>
    </div>
</section>

