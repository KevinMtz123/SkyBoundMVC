
@{
    ViewBag.Title = "Ave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Mantenimiento</a></li>
    <li class="breadcrumb-item active">Aves</li>
</ol>
<div class="card">
    <div class="card-header">
        <i class="fas fa-boxes me-1"></i>Lista de Aves
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success" onclick="abrirModal(null)">Crear nuevo</button>
            </div>
        </div>

        <hr />

        <table id="tabla" class="disolay cell-border" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripcion</th>
                    <th>Familia</th>
                    <th>Categoria Estacional</th>
                    <th>Estatus de proteccion</th>
                    <th>Habitat</th>
                    <th>Alimentacion</th>
                    <th>Funcion en Ecosistema</th>
                    <th>Activa</th>
                    <th>Lista roja</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<!--Modal-->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="exampleModalLabel">Aves</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />


                <form id="contenedor" class="row">

                    <div class="col-sm-3">
                        <div class="mb-2">
                            <img id="img_ave" height="197" width="200" class="border rounded mx-auto d-block img-fluid" />
                        </div>
                        <div class="mb-2">
                            <input class="form-control" type="file" id="fileAve" accept="image/png,image/jpg,image/jpeg" onchange="mostrarImagen(this)" />
                        </div>

                    </div>

                    <div class="col-sm-3">
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="txtnombre" name="nombre" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripcion</label>
                            <textarea type="text" class="form-control" id="txtdescripcion" name="descripcion" style="height:125px;resize:none"></textarea>
                        </div>

                    </div>

                    <div class="col-sm-3">

                        <div class="mb-3">
                            <label class="form-label">Estatus de proteccion</label>
                            <select id="cboestatus" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Categoria Estacional</label>
                            <select id="cbocategoria" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Familia</label>
                            <select id="cbofamilia" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Habitat</label>
                            <select id="cbohabitat" class="form-select"></select>
                        </div>


                    </div>

                    

                    <div class="col-sm-3">
                        <div class="mb-3">
                            <label class="form-label">Alimentacion</label>
                            <input type="text" class="form-control" id="txtalimentacion" name="alimentacion" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Funcion Ecosistema</label>
                            <input type="text" class="form-control" id="txtfuncion" name="funcionecos" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Activa</label>
                            <select id="cboactiva" class="form-select">
                                <option value="1">Si</option>
                                <option value="0">No</option>
                            </select>

                        </div>
                        <div class="mb-3">
                            <label class="form-label">Lista Roja</label>
                            <select id="cbolista" class="form-select">
                                <option value="1">Si</option>
                                <option value="0">No</option>
                            </select>

                        </div>

                    </div>


                </form>






                <div class="row mt-2">
                    <div class="col-12">
                        <div id="mensajeError" class="alert alert-danger" role="alert">

                        </div>
                    </div>
                </div>


            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>


@*Nos permite escribir nuestros scripts para mandar llamar nuestros datos ya guardados y se muestren en la tabla
    Obtenemos nuestra lista
*@
@section scripts
    {

    <script>
        $(document).ready(function () {
            MostrarAve();
            mostrarImagen();
        })

        var tabladata;
        var filaSeleccionada;

        function mostrarImagen(input) {
            if (input.files) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $("#img_ave").attr("src", e.target.result).width(200).height(197)

                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        function MostrarAve() {
            tabladata = $("#tabla").DataTable({
    responsive: true,
    ordering: false,
    "ajax": {
          url: '@Url.Action("ListarAve", "Mantenedor")', //origen de la lista
          type: "Get",//Recibe
        dataType: "json"


    },
    "columns": [ //columnas que obtiene los datos
        { "data": "Nombre" },
        { "data": "Descripcion" },

        {
            "data": "oFamilia", "render": function (data) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                return data.Descripcion
            }
        },
        {
            "data": "oCategoriaEstacional", "render": function (data) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                return data.Descripcion
            }
        },{
            "data": "oEstatusProteccion", "render": function (data) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                return data.Descripcion
            }
        },
        {
            "data": "oHabitat", "render": function (data) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                return data.Descripcion
            }
        },
        { "data": "Alimentacion" },
        { "data": "FuncionEcos" },

        {
            "data": "Activa", "render": function (valor) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                if (valor) {
                    return '<span class="badge rounded-pill text-bg-success">Si</span>'
                } else {
                    return '<span class="badge rounded-pill text-bg-danger">No</span>'
                }
            }
        },
        {
            "data": "ListaRoja", "render": function (valor) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                if (valor) {
                    return '<span class="badge rounded-pill text-bg-success">Si</span>'
                } else {
                    return '<span class="badge rounded-pill text-bg-danger">No</span>'
                }
            }
        },
        {                //contenedor para los dos botones de crear y eliminar, se concatena con signo +
            "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pen"></i></button>' +
                '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class="fas fa-trash"></i></button>',
                "orderable": false,
            "searchable": false,
                "width":"90 px"

        }
    ],
    "language": {//cambiar idioma al datatable
        "url":"//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
    }

});
        }



        //Pendienteeeeeeeeeeeeeeee



         jQuery.ajax({
   url: '@Url.Action("ListarEstatus", "Mantenedor")',
     type: "GET",
     data: null,
     dataType: "json",
     contentType: "application/json; charset=utf-8",
     success: function (data) {

         console.log(data)

         $("<option>").attr({ "value": "0", "disabled": "true" }).text("Seleccionar").appendTo("#cboestatus")

         $.each(data.data, function (index, item){

             $("<option>").attr({ "value": item.IdEstatus }).text(item.Descripcion).appendTo("#cboestatus")
         })

     },
     error: function (error) {
         console.log(error);

             }


         });
                         jQuery.ajax({
  url: '@Url.Action("ListarCategoria", "Mantenedor")', //llamamos este metodo
    type: "GET",
    data: null,//pasamos valores convertidos en texto, propiedades similares de nuestro controlador
    dataType: "json",
    contentType: "application/json; charset=utf-8",
    success: function (data) {

        console.log(data)

        $("<option>").attr({ "value": "0", "disabled": "true" }).text("Seleccionar").appendTo("#cbocategoria")

        $.each(data.data, function (index, item){

            $("<option>").attr({ "value": item.IdCategoria }).text(item.Descripcion).appendTo("#cbocategoria")
        })

    },
    error: function (error) {//que pasa si sucede un error
        console.log(error);

            }


                         });
                jQuery.ajax({
        url: '@Url.Action("ListarFamilia", "Mantenedor")',
          type: "GET",
          data: null,
          dataType: "json",
          contentType: "application/json; charset=utf-8",
          success: function (data) {

              console.log(data)

              $("<option>").attr({ "value": "0", "disabled": "true" }).text("Seleccionar").appendTo("#cbofamilia")

              $.each(data.data, function (index, item){

                  $("<option>").attr({ "value": item.IdFamilia }).text(item.Descripcion).appendTo("#cbofamilia")
              })

          },
          error: function (error) {
              console.log(error);

                  }


              });

                      jQuery.ajax({
        url: '@Url.Action("ListarHabitat", "Mantenedor")',
          type: "GET",
          data: null,
          dataType: "json",
          contentType: "application/json; charset=utf-8",
          success: function (data) {

              console.log(data)

              $("<option>").attr({ "value": "0", "disabled": "true" }).text("Seleccionar").appendTo("#cbohabitat")

              $.each(data.data, function (index, item){

                  $("<option>").attr({ "value": item.IdHabitat }).text(item.Descripcion).appendTo("#cbohabitat")
              })

          },
          error: function (error) {
              console.log(error);

                  }


              });




        //metodo para  modal de crear nuevo
        function abrirModal(json) {

            $("#txtid").val(0);
            $("#img_ave").removeAttr("src");
            $("#fileAve").val("");
            $("#txtnombre").val("");
            $("#txtdescripcion").val("");

            $("#cboestatus").val($("#cboestatus option:first").val());
            $("#cbocategoria").val($("#cbocategoria option:first").val());
            $("#cbofamilia").val($("#cbofamilia option:first").val());
            $("#cbohabitat").val($("#cbohabitat option:first").val());
            $("#txtalimentacion").val("");
            $("#txtfuncion").val("");
            $("#cboactiva").val(1);
            $("#cbolista").val(1);




            $("#mensajeError").hide();

            if (json != null) {
                $("#txtid").val(json.IdAve);
                $("#txtnombre").val(json.Nombre);
                $("#txtdescripcion").val(json.Descripcion);
                $("#cboestatus").val(json.oEstatusProteccion.IdEstatus);
                $("#cbocategoria").val(json.oCategoriaEstacional.IdCategoria);
                $("#cbofamilia").val(json.oFamilia.IdFamilia);
                $("#cbohabitat").val(json.oHabitat.IdHabitat);
                $("#txtalimentacion").val(json.Alimentacion);
                $("#txtfuncion").val(json.FuncionEcos);
                $("#cboactiva").val(json.Activa == true ? 1 : 0);
                $("#cbolista").val(json.ListaRoja == true ? 1 : 0);


                           jQuery.ajax({
                url: '@Url.Action("ImagenAve", "Mantenedor")', //llamamos este metodo
                               type: "POST",
                               data: JSON.stringify({ id: json.IdAve }),//pasamos valores convertidos en texto, propiedades similares
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.conversion) {
                        $("#img_ave").attr({ "src": "data:image/" + data.extension + ";base64," + data.textobase64 });
                    }
           },

    error: function (error) {//que pasa si sucede un error

        $("#img_ave").LoadingOverlay("hide");

        $("#mensajeError").show();
        $("#mensajeError").text("Error al mostrar imagen");
                },
                               beforeSend: function () {

                                   $("#img_ave").LoadingOverlay("hide");
                               },
});







            }
            $("#FormModal").modal("show");
        }
        //funciones al hacer click a mi boton de la clase btn editar
        $("#tabla tbody").on("click", '.btn-editar', function () {
             filaSeleccionada = $(this).closest("tr");

            var data = tabladata.row(filaSeleccionada).data(); //seleccionamos todos los datos de la fila seleccionada, this es "de esa misma"

            abrirModal(data)
        })


        //funciones al hacer click a mi boton de la clase btn eliminar

        $("#tabla tbody").on("click", '.btn-eliminar', function () {
    var aveseleccionado = $(this).closest("tr");

    var data = tabladata.row(aveseleccionado).data();

    swal({
        title: "Estas seguro?",
        text: "Desea eliminar esta Ave!",
        type: "warning",
        showCancelButton: true,
        confirmButtonClass: "btn-primary",
        confirmButtonText: "Si, eliminar!",
        cancelButtonText: "No",
        closeOnConfirm: true
    },
        function () {
            jQuery.ajax({
              url: '@Url.Action("EliminarAve", "Mantenedor")', //llamamos este metodo
                type: "POST",
                data: JSON.stringify({ id: data.IdAve }),//pasamos valores convertidos en texto, propiedades similares
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {


                    if (data.resultado) {
                        tabladata.row(aveseleccionado).remove().draw();
                    } else {
                        swal("No se pudo eliminar", data.mensaje,"error")
                    }
                },
                error: function (error) {//que pasa si sucede un error
                    console.log(error);

                }

            });

        });

            console.log(data);
})




        function Guardar() {

            if (!$("#contenedor").valid()) {
                return;
            }

            var ImagenSeleccionada = $("#fileAve")[0].files[0];



            var Ave = {
                IdAve: $("#txtid").val(),
                Nombre: $("#txtnombre").val(),
                Descripcion: $("#txtdescripcion").val(),
                oEstatusProteccion: {
                    IdEstatus: $("#cboestatus option:selected").val(),
                    Descripcion: $("#cboestatus option:selected").text(),
                },
                oCategoriaEstacional: {
                    IdCategoria: $("#cbocategoria option:selected").val(),
                    Descripcion: $("#cbocategoria option:selected").text(),
                },
                oFamilia: {
                    IdFamilia: $("#cbofamilia option:selected").val(),
                    Descripcion: $("#cbofamilia option:selected").text(),
                },
                oHabitat: {
                    IdHabitat: $("#cbohabitat option:selected").val(),
                    Descripcion: $("#cbohabitat option:selected").text(),
                },
                Alimentacion: $("#txtalimentacion").val(),
                FuncionEcos: $("#txtfuncion").val(),

                Activa: $("#cboactiva").val() == 1 ? true : false,
                ListaRoja: $("#cbolista").val() == 1 ? true : false,
            }

            var request = new FormData();
            request.append("objeto", JSON.stringify(Ave))
            request.append("archivoImagen", ImagenSeleccionada )






            jQuery.ajax({
                url: '@Url.Action("GuardarAve", "Mantenedor")', //llamamos este metodo
                type: "POST",
                data: request,//pasamos valores convertidos en texto, propiedades similares
                processData: false,
                contentType: false,
                success: function (data) {//cuando ha sido exitoso se ejecuta success


                    //usuario nuevo

                    if (Ave.IdAve == 0) {

                        if (data.idGenerado != 0) {

                            Ave.IdAve = data.idGenerado;

                            tabladata.row.add(Ave).draw(false);

                            $("#FormModal").modal("hide");

                        } else {

                            $("#mensajeError").text(data.mensaje);

                            $("#mensajeError").show();
                        }



                    }
                    //usuario editar
                    else {

                        if (data.operacionExitosa) {

                            tabladata.row(filaSeleccionada).data(Ave).draw(false);
                            filaSeleccionada = null;
                            $("#FormModal").modal("hide");

                        } else {
                            $("#mensajeError").text(data.mensaje);

                            $("#mensajeError").show();
                        }



                    }


                },
                error: function (error) {//que pasa si sucede un error
                    $(".modal-body").LoadingOverlay("hide");

                    $("#mensajeError").text("Error Ajax");

                    $("#mensajeError").show();

                },

            }



            );






        }
    </script>
}

