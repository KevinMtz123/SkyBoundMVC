
@{
    ViewBag.Title = "Habitat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Mantenimiento</a></li>
    <li class="breadcrumb-item active">Habitat</li>
</ol>
<div class="card">
    <div class="card-header">
        <i class="fas fa-users me-1"></i>Lista de Habitat
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success" onclick="abrirModal(null)">Crear nuevo</button>
            </div>
        </div>

        <hr />

        <table id="tabla" class="disolay cell-border" style="width:100%">
            <thead>
                <tr>
                    <th>Descripcion</th>

                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<!--Modal-->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="exampleModalLabel">Habitat</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                @*campos dentro del modal*@
                <div class="row  g-1">


                    <div class="col-sm-6">
                        <label for="txtdescripcion" class="form-label">Descripcion</label>
                        <input type="text" class="form-control" id="txtdescripcion">
                    </div>

                    <div class="col-sm-6">
                        <label for="cboactivo" class="form-label">Activo</label>
                        <select id="cboactivo" class="form-select">

                            <option value="1">Si</option>
                            <option value="0">No</option>

                        </select>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12">
                        <div id="mensajeError" class="alert alert-danger" role="alert">
                            A simple danger alert—check it out!
                        </div>
                    </div>
                </div>


            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>


@*Nos permite escribir nuestros scripts para mandar llamar nuestros datos ya guardados y se muestren en la tabla
    Obtenemos nuestra lista
*@
@section scripts
    {

    <script>
        var tabladata;
        var filaSeleccionada;

        //en formato de tabla el ajax traera los datos que tenemos declarados en el constructor, desde su origen
        tabladata = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                  url: '@Url.Action("ListarHabitat", "Mantenedor")', //origen de la lista
                  type: "Get",//Recibe
                  dataType: "json"
            },
            "columns": [ //columnas que obtiene los datos
                {"data": "Descripcion"},

                {
                    "data": "Activo", "render": function (valor) { //funcion para ver si es activo, e imprime mensaje con cierto diseño
                        if (valor) {
                            return '<span class="badge rounded-pill text-bg-success">Si</span>'
                        } else {
                            return '<span class="badge rounded-pill text-bg-danger">No</span>'
                        }
                    }
                },
                {                //contenedor para los dos botones de crear y eliminar, se concatena con signo +
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class="fas fa-trash"></i></button>',
                        "orderable": false,
                    "searchable": false,
                        "width":"90 px"

                }
            ],
            "language": {//cambiar idioma al datatable
                "url":"//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
            }
        });


        //metodo para  modal de crear nuevo
        function abrirModal(json) {

            $("#txtid").val(0);
            $("#txtdescripcion").val("");
            $("#cboactivo").val(1);

            $("#mensajeError").hide();

            if (json != null) {
                $("#txtid").val(json.IdHabitat);
                $("#txtdescripcion").val(json.Descripcion);
                $("#cboactivo").val(json.Activo==true?1:0);
            }
            $("#FormModal").modal("show");
        }
        //funciones al hacer click a mi boton de la clase btn editar
        $("#tabla tbody").on("click", '.btn-editar', function () {
             filaSeleccionada = $(this).closest("tr");

            var data = tabladata.row(filaSeleccionada).data(); //seleccionamos todos los datos de la fila seleccionada, this es "de esa misma"

            abrirModal(data)
        })


        //funciones al hacer click a mi boton de la clase btn eliminar
        @**@
        $("#tabla tbody").on("click", '.btn-eliminar', function () {
            var HabitatSeleccionada = $(this).closest("tr");

            var data = tabladata.row(HabitatSeleccionada).data();

            swal({
                title: "Estas seguro?",
                text: "Desea eliminar esta habitat?!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-primary",
                confirmButtonText: "Si, eliminar!",
                cancelButtonText: "No",
                closeOnConfirm: true
            },
                function () {
                    jQuery.ajax({
                      url: '@Url.Action("EliminarHabitat", "Mantenedor")', //llamamos este metodo
                        type: "POST",
                        data: JSON.stringify({ id: data.IdHabitat }),//pasamos valores convertidos en texto, propiedades similares de nuestro controlador
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {


                            if (data.resultado) {
                                tabladata.row(HabitatSeleccionada).remove().draw();
                            } else {
                                swal("No se pudo eliminar", data.mensaje,"error")
                            }
                        },
                        error: function (error) {//que pasa si sucede un error
                            console.log(error);

                        }

                    });

                });

                    console.log(data);
        })




        function Guardar() {
            var Habitat = {
                IdHabitat: $("#txtid").val(),
                Descripcion: $("#txtdescripcion").val(),
                Activo: $("#cboactivo").val() == 1 ? true : false,
            }

            jQuery.ajax({
                url: '@Url.Action("GuardarHabitat", "Mantenedor")', //llamamos este metodo
                type: "POST",
                data: JSON.stringify({ objeto: Habitat }),//pasamos valores convertidos en texto, propiedades similares
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {//cuando ha sido exitoso se ejecuta success


                    //usuario nuevo

                    if (Habitat.IdHabitat == 0) {

                        if (data.resultado != 0) {

                            Habitat.IdHabitat = data.resultado;

                            tabladata.row.add(Habitat).draw(false);

                            $("#FormModal").modal("hide");

                        } else {

                            $("#mensajeError").text(data.mensaje);

                            $("#mensajeError").show();
                        }



                    }
                    //usuario editar
                    else {

                        if (data.resultado) {

                            tabladata.row(filaSeleccionada).data(Habitat).draw(false);
                            filaSeleccionada = null;
                            $("#FormModal").modal("hide");

                        } else {
                            $("#mensajeError").text(data.mensaje);

                            $("#mensajeError").show();
                        }



                    }


                },
                error: function (error) {//que pasa si sucede un error
                    $(".modal-body").LoadingOverlay("hide");

                    $("#mensajeError").text("Error Ajax");

                    $("#mensajeError").show();

                },

                }



            );






        }
    </script>
}

